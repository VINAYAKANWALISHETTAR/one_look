# One Look backend — copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development
PORT=4000

# --- PostgreSQL ---------------------------------------------------------
# Local development. In production point this at Amazon RDS PostgreSQL.
DATABASE_URL=postgres://onelook:onelook@localhost:5432/onelook
# Set to "true" for RDS (TLS required, AWS-managed CA).
PGSSL=false
PG_POOL_MAX=10

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-in-every-environment
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed browser origins (no wildcards in production).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Limits -------------------------------------------------------------
JSON_BODY_LIMIT=256kb

# --- Google / Gmail (Phase 5) -------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Enable the Gmail API for the same project.
# The client secret stays on the server; the browser never receives it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client EXACTLY.
# Dev:  http://localhost:4000/api/integrations/google/callback
# Prod: https://api.your-domain.com/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Where the One Look frontend is served from — used to post the OAuth result
# back to the app window.
APP_ORIGIN=http://localhost:8080

# AES-256-GCM key encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
# Required whenever GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI are set.
# Rotating this value invalidates stored tokens: users reconnect Gmail once.
TOKEN_ENCRYPTION_KEY=

# --- Reserved for later phases (do NOT add secrets to the frontend) -----
# Google Calendar, LinkedIn, News and AI keys arrive in later phases.
